pipeline {
 agent any
 stages {
  stage('Git') {
   steps {git 'https://github.com/netology-code/sdvps-materials.git'}
  }
  stage('Test') {
   steps {
    sh '/usr/local/go/bin/go test .'
   }
  }
  stage('Build') {
   steps {
    sh 'CGO_ENABLED=0 GOOS=linux /usr/local/go/bin/go build -a -installsuffix nocgo -o hello-world .'
   }
  }
  stage('Upload') {
  steps {
    sh 'curl -f -u admin:12345678 --upload-file hello-world http://ubuntu-bionic:8081/repository/raw-hosted/hello-world-v$BUILD_NUMBER'
   }
  }
 }
}